# Database Configuration
# PostgreSQL is now the default database
# Set to 'sqlite' to use SQLite instead
DB_TYPE=postgres

# Set to 'true' to use SQLite instead of PostgreSQL
USE_SQLITE=false

# PostgreSQL Configuration (only needed if using PostgreSQL)
# For Render PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=curriculum_crafter
DB_USER=postgres
DB_PASSWORD=your_password_here

# For Aiven PostgreSQL (replace with your actual values):
# DB_HOST=your-service-name-your-project.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password_here

# Alternative: Use DATABASE_URL for Aiven (recommended)
# DATABASE_URL=postgresql://avnadmin:your_password@your-service-name-your-project.aivencloud.com:12345/defaultdb?sslmode=require

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
