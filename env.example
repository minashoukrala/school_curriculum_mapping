# Database Configuration
# Set to 'postgres' to use PostgreSQL, leave unset for SQLite
DB_TYPE=postgres

# Alternative flag to enable PostgreSQL
USE_POSTGRES=true

# PostgreSQL Configuration (only needed if using PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=curriculum_crafter
DB_USER=postgres
DB_PASSWORD=your_password_here

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
